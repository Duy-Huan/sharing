%% test_allan_matlab.m  -  pure MATLAB test suite for allan_analysis.m
% Needs only base MATLAB (R2016b or newer: local functions at end of script,
% movmean). No toolbox, no external library, no Python.
% Put this file and allan_analysis.m in the same folder and run: test_allan_matlab
clear; clc; close all;

outdir = fullfile(pwd, 'allan_test_out');
if ~exist(outdir, 'dir'), mkdir(outdir); end
oldVis = get(0, 'DefaultFigureVisible');
set(0, 'DefaultFigureVisible', 'off');          % save figures without popping windows
cleanupObj = onCleanup(@() set(0, 'DefaultFigureVisible', oldVis));

Kbi  = sqrt(2*log(2)/pi);                       % 0.6643 : ADEV floor / B for true 1/f
recs = {};

%% S1  White noise (ARW)
rng(11); dt = 1e-3; N = 1e6; sg = 0.01;
y = sg*randn(N,1);
r = allan_analysis(y, dt, 'Detrend', 'mean');   savefig_(outdir, 'S1_white');
model = sg*sqrt(dt./r.tau);  cv = coverage(r, model);
ok = abs(r.N_arw/(sg*sqrt(dt)) - 1) < 0.05 && ~r.hasMin && ~r.hasPlateau && cv >= 0.95;
recs{end+1} = rec_('S1 white noise (ARW)', ok, sprintf( ...
    'N_est/N_true=%.3f, coverage(3sigma)=%.2f, hasMin=%d, verdict: %s', ...
    r.N_arw/(sg*sqrt(dt)), cv, r.hasMin, r.verdict));
y1 = y;

%% S2  Rate random walk (RRW)
rng(12); dt = 1e-2; N = 1e6; ss = 1e-4;
y = cumsum(ss*randn(N,1));  Ktrue = ss/sqrt(dt);
r = allan_analysis(y, dt, 'Detrend', 'none');   savefig_(outdir, 'S2_rrw');
model = Ktrue*sqrt(r.tau/3);  cv = coverage(r, model);
ok = abs(r.K_rrw/Ktrue - 1) < 0.15 && ~r.hasMin && cv >= 0.8;
recs{end+1} = rec_('S2 rate random walk (RRW)', ok, sprintf( ...
    'K_est/K_true=%.3f, coverage=%.2f, hasMin=%d, verdict: %s', ...
    r.K_rrw/Ktrue, cv, r.hasMin, r.verdict));

%% S3  Rate ramp
dt = 1e-2; N = 1e6; R = 1e-4; t = (0:N-1)'*dt; y = R*t;
r = allan_analysis(y, dt, 'Detrend', 'none');   savefig_(outdir, 'S3_ramp');
model = R*r.tau/sqrt(2);  err = max(abs(r.adev./model - 1));
ok = abs(r.R_rr/R - 1) < 0.05 && ~r.hasMin && err < 0.02;
recs{end+1} = rec_('S3 rate ramp', ok, sprintf( ...
    'R_est/R_true=%.3f, max|adev/model-1|=%.4f, verdict: %s', r.R_rr/R, err, r.verdict));

%% S4  Classic: ARW + true 1/f + RRW  (expect clear flat minimum)
rng(14); dt = 0.1; N = 2^21; B = 0.01; sw = 0.05; Kr = 2e-4;
y = sw*randn(N,1) + gen_flicker(N, dt, B) + cumsum(Kr*sqrt(dt)*randn(N,1));
r = allan_analysis(y, dt, 'Detrend', 'mean');   savefig_(outdir, 'S4_classic_BI');
Nw = sw*sqrt(dt);
model = sqrt(Nw^2./r.tau + (Kbi*B)^2 + Kr^2*r.tau/3);  cv = coverage(r, model);
BImodel = min(model)/Kbi;
ok = r.hasPlateau && abs(r.BI/BImodel - 1) < 0.15 && cv >= 0.85;
recs{end+1} = rec_('S4 ARW + 1/f + RRW (classic BI)', ok, sprintf( ...
    'BI_est=%.4g, BI_from_model_min=%.4g, B_true=%.4g, plateau=%.2f dec, coverage=%.2f, verdict: %s', ...
    r.BI, BImodel, B, r.plateau_decades, cv, r.verdict));
y4 = y;

%% S5  Your flicker model only (IIR alpha=0.995, dt=1e-3)  -> expect a bump, not a flat minimum
rng(15); dt = 1e-3; N = 2e6; a = 0.995; Bb = 0.0224;
y = Bb*sqrt(dt)*filter(1-a, [1 -a], randn(N,1));  tc = -dt/log(a);
r = allan_analysis(y, dt, 'Detrend', 'mean');   savefig_(outdir, 'S5_user_flicker_only');
ok = r.hasPeak && abs(r.tauc_est/tc - 1) < 0.3 && ~r.hasPlateau;
recs{end+1} = rec_('S5 user IIR flicker only', ok, sprintf( ...
    'hasPeak=%d, tau_peak=%.3g s, Tc_est=%.3g s (true %.3g s), hasMin=%d, verdict: %s', ...
    r.hasPeak, r.tau_peak, r.tauc_est, tc, r.hasMin, r.verdict));

%% S6  main.m noise set: flicker + RRW(1e-4) + RR(1e-5)  -> BI hidden
rng(16); dt = 1e-3; N = 2e6; t = (0:N-1)'*dt;
y = Bb*sqrt(dt)*filter(1-a, [1 -a], randn(N,1)) + cumsum(1e-4*sqrt(dt)*randn(N,1)) + 1e-5*t;
r = allan_analysis(y, dt, 'Detrend', 'mean');   savefig_(outdir, 'S6_user_main_noise_set');
ok = ~r.hasPlateau;
recs{end+1} = rec_('S6 main.m noise set (RRW+RR on)', ok, sprintf( ...
    'hasMin=%d, hasPeak=%d, K_est=%.3g (true 1e-4), R_est=%.3g (true 1e-5), verdict: %s', ...
    r.hasMin, r.hasPeak, r.K_rrw, r.R_rr, r.verdict));

%% S7  Your flicker + small white noise
rng(17); dt = 1e-3; N = 2e6; sw = 3e-5;
y = Bb*sqrt(dt)*filter(1-a, [1 -a], randn(N,1)) + sw*randn(N,1);
r = allan_analysis(y, dt, 'Detrend', 'mean');   savefig_(outdir, 'S7_user_flicker_plus_white');
ok = r.hasPeak && abs(r.tauc_est/tc - 1) < 0.3;
recs{end+1} = rec_('S7 user IIR flicker + white', ok, sprintf( ...
    'hasMin=%d, hasPlateau=%d, hasPeak=%d, Tc_est=%.3g (true %.3g), N_est=%.3g (true %.3g), verdict: %s', ...
    r.hasMin, r.hasPlateau, r.hasPeak, r.tauc_est, tc, r.N_arw, sw*sqrt(dt), r.verdict));

%% S8  Deterministic drift: effect of Detrend option (S4 noise + linear drift)
dt = 0.1; N = 2^21; t = (0:N-1)'*dt;  yd = y4 + 1e-4*t;
rm = allan_analysis(yd, dt, 'Detrend', 'mean');    savefig_(outdir, 'S8a_drift_detrend_mean');
rl = allan_analysis(yd, dt, 'Detrend', 'linear');  savefig_(outdir, 'S8b_drift_detrend_linear');
rp = allan_analysis(yd, dt, 'Detrend', 'poly2', 'Plot', false);
ok = rl.hasPlateau && rp.hasPlateau && (rl.plateau_decades > rm.plateau_decades + 0.5) ...
     && rm.BI > rl.BI && abs(rl.BI/BImodel - 1) < 0.15;
recs{end+1} = rec_('S8 drift: mean vs linear vs poly2 detrend', ok, sprintf( ...
    'mean: plateau=%.2f dec, BI=%.4g | linear: plateau=%.2f dec, BI=%.4g | poly2: plateau=%.2f dec, BI=%.4g | BI_model=%.4g', ...
    rm.plateau_decades, rm.BI, rl.plateau_decades, rl.BI, rp.plateau_decades, rp.BI, BImodel));

%% S9  Consistency: Type 'angle' vs 'rate', Scale linearity
dt = 1e-3; yy = y1(1:2e5);
ra = allan_analysis(yy, dt, 'Detrend', 'none', 'Plot', false);
rb = allan_analysis([0; cumsum(yy)*dt], dt, 'Type', 'angle', 'Detrend', 'none', 'Plot', false);
rc = allan_analysis(yy, dt, 'Detrend', 'none', 'Scale', 3600, 'Plot', false);
e1 = max(abs(ra.adev./rb.adev(1:numel(ra.adev)) - 1));
e2 = max(abs(rc.adev./(3600*ra.adev) - 1));
ok = numel(ra.tau) == numel(rb.tau) && e1 < 1e-6 && e2 < 1e-12;
recs{end+1} = rec_('S9 rate-vs-angle equivalence & Scale linearity', ok, sprintf( ...
    'same taus=%d, max rel diff rate/angle=%.2e, scale=%.2e', numel(ra.tau)==numel(rb.tau), e1, e2));

%% S10 Independent cross-check: window-average definition (different formula, pure MATLAB)
%   sigma^2(m) = 1/(2*(N-2m+1)) * sum( (ybar_{i+m} - ybar_i)^2 ),  ybar = mean of m consecutive samples
dt = 1e-3; yc = y1(1:2e4);  Nc = numel(yc);
rr = allan_analysis(yc, dt, 'Detrend', 'none', 'Plot', false);
mlist = round(rr.tau/dt);  worst = 0;
for i = 1:numel(mlist)
    m = mlist(i);
    ybar = filter(ones(m,1)/m, 1, yc);  ybar = ybar(m:end);     % all window means
    dd = ybar(1+m:end) - ybar(1:end-m);
    ref = sqrt(sum(dd.^2)/(2*numel(dd)));
    worst = max(worst, abs(rr.adev(i)/ref - 1));
end
ok = worst < 1e-8;
recs{end+1} = rec_('S10 independent window-average cross-check', ok, sprintf( ...
    '%d tau points, max rel diff=%.2e', numel(mlist), worst));

%% S11 Input validation
e = 0;
try, allan_analysis([1 NaN 3 4], 1);                         catch, e = e+1; end
try, allan_analysis(randn(50,1), 1);                         catch, e = e+1; end
try, allan_analysis(randn(1000,1), 1, 'Detrend', 'bogus');   catch, e = e+1; end
recs{end+1} = rec_('S11 input validation (NaN / short / bad option)', e == 3, ...
    sprintf('%d of 3 invalid calls raised errors', e));

%% Summary
npass = sum(cellfun(@(x) x.pass, recs));
fprintf('\n=========== SUMMARY: %d / %d passed ===========\n', npass, numel(recs));
fid = fopen(fullfile(outdir, 'summary.txt'), 'w');
for i = 1:numel(recs)
    fprintf(fid, '%s\t%s\t%s\n', ifelse_(recs{i}.pass, 'PASS', 'FAIL'), recs{i}.name, recs{i}.info);
end
fclose(fid);
fprintf('Figures and summary.txt saved in: %s\n', outdir);

%% ---------------- local functions (must stay at end of script) ----------------
function x = gen_flicker(N, dt, B)
% 1/f noise whose ADEV plateau equals sqrt(2*ln2/pi)*B
k = (1:N/2)';  f = k/(N*dt);
H = sqrt(B^2./(2*pi*f)/dt);
Hf = [0; H(1:N/2-1); H(N/2); flipud(H(1:N/2-1))];
x = real(ifft(fft(randn(N,1)).*Hf));
end

function c = coverage(res, model)
% fraction of tau points where measured ADEV is within 3 x (approx. 1-sigma band) of the model
rel = (res.ci_hi - res.ci_lo)./(2*res.adev);
c = mean(abs(res.adev./model - 1) <= 3*rel);
end

function savefig_(outdir, name)
print(gcf, fullfile(outdir, [name '.png']), '-dpng', '-r110');
close(gcf);
end

function rec = rec_(name, pass, info)
rec = struct('name', name, 'pass', pass, 'info', info);
fprintf('>>> [%s] %s | %s\n', ifelse_(pass, 'PASS', 'FAIL'), name, info);
end

function s = ifelse_(c, a, b)
if c, s = a; else, s = b; end
end
